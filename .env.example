# Locus reads the repository-root .env (Locus/.env). Variables it needs:

# Supabase Postgres: use the Session pooler string (Dashboard → Connect → Session pooler).
# The direct db.<ref>.supabase.co host is IPv6-only and won't resolve on most networks.
DATABASE_URL=

# Sarvam (default for call speech and the fallback matcher). Saaras v3 STT, Bulbul v3 TTS, sarvam-105b chat.
SARVAM_API_KEY=
SARVAM_LLM_MODEL=sarvam-105b
SARVAM_TTS_SPEAKER=simran
LOCUS_SPEECH_PROVIDER=sarvam        # sarvam | openai (worker STT/TTS)
LOCUS_RESOLVER_PROVIDER=sarvam      # sarvam | openai (fallback position matching)

# OpenAI: walk-video frame vision, and the comparison arm for speech and matching. Pin exact model ids.
OPENAI_API_KEY=
OPENAI_MODEL=
# Walk-video landmark vision; defaults to OPENAI_MODEL when unset.
OPENAI_VISION_MODEL=
OPENAI_STT_MODEL=
OPENAI_TTS_MODEL=

# Supabase Auth (recipient sign-in with Google). Add http://localhost:3000 to Auth → URL Configuration → Redirect URLs.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=       # public; reaches the browser
SUPABASE_JWKS_URL=              # API verifies recipient tokens (ES256) against this

# Guide API
LOCUS_PORT=8787
LOCUS_WEB_ORIGIN=http://localhost:3000   # CORS for the recipient web app

# Call worker
LOCUS_API_URL=http://localhost:8787
LOCUS_WORKER_API_KEY=            # from: pnpm --filter @locus/api admin client locus-worker --first-party
LOCUS_DEFAULT_LANGUAGE=hi
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=  # outbound trunk to Plivo, used for handoff calls
LOCUS_OUTBOUND_NUMBER=           # caller ID on handoff calls; also register it with: admin outbound <number>

# Optional: Overpass endpoint for the OSM import
OVERPASS_URL=
