[Unit]
Description=Locus call worker (LiveKit Agents)
After=network-online.target locus-api.service

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/Locus
ExecStart=/usr/bin/env pnpm --filter @locus/api worker start
Restart=always
RestartSec=3
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
